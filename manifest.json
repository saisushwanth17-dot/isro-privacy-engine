{
  "manifest_version": 3,
  "name": "ISRO On-Device Privacy Agent (SIH 2026)",
  "version": "1.0.0",
  "description": "On-Device Visual & Accessibility Perception Engine with Zero-Leakage PII Redaction",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ISRO Privacy Perception Engine"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "accessibility_sanitizer.js",
        "accessibility_walker.js",
        "privacy_engine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
